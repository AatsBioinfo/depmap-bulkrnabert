Bootstrap: docker
From: ubuntu:22.04

%labels
  Project BulkRNABert-DepMap-GPU

%environment
  export LC_ALL=C.UTF-8
  export LANG=C.UTF-8
  export PYTHONUNBUFFERED=1
  # IMPORTANT:
  # Do NOT force CPU here. Let JAX detect GPU automatically.
  # export JAX_PLATFORM_NAME=cpu

%post
  set -eux
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-pip python3-dev \
      git ca-certificates build-essential \
  && rm -rf /var/lib/apt/lists/*

  python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

  # scientific stack
  python3 -m pip install --no-cache-dir \
      numpy pandas tqdm scikit-learn matplotlib umap-learn

  # JAX + Haiku (GPU, CUDA 12)
  python3 -m pip install --no-cache-dir "jax[cuda12]" dm-haiku

  # install BulkRNABert code
  python3 -m pip install --no-cache-dir -e /opt/multiomics-open-research

%files
  /fast/home/a/abejoy/data/bulkrnabert/multiomics-open-research /opt/multiomics-open-research

%runscript
  exec "$@"
